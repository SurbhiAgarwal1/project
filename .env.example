# Opsara Environment Configuration

# LLM Provider Configuration (OpenAI API)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Backend API Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:opsarapassword@localhost:5432/opsara

# Kubernetes Configuration
# Leave empty to use default ~/.kube/config or in-cluster credentials
KUBECONFIG_PATH=
DEFAULT_NAMESPACE=opsara-demo
CLUSTER_NAME=opsara

# Risk Engine Policy Defaults
AUTO_APPROVE_READ_ONLY=true
REQUIRE_APPROVAL_MEDIUM_RISK=true
REQUIRE_APPROVAL_HIGH_RISK=true
